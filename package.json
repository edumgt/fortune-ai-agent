{
  "name": "fortune-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm -C apps/api dev & pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "test": "node --test packages/engine/test/*.test.js",
    "lint": "echo \"(demo)\""
  }
}
